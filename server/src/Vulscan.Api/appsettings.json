{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "VulscanDb": "Server=localhost,1433;Database=VulscanDb;User Id=sa;Password=${SQL_SERVER_PASSWORD};TrustServerCertificate=true;MultipleActiveResultSets=true"
  },
  "Jwt": {
    "SecretKey": "${JWT_SECRET_KEY}",
    "Issuer": "VulscanApi",
    "Audience": "VulscanDashboard",
    "ExpirationMinutes": 30,
    "RefreshTokenHours": 12
  },
  "Auth": {
    "Local": { "Enabled": true },
    "Entra": {
      "Enabled": false,
      "TenantId": "",
      "ClientId": "",
      "RoleMapping": {
        "Vulscan.Admin": "Admin",
        "Vulscan.SecurityAnalyst": "SecurityAnalyst",
        "Vulscan.Viewer": "Viewer"
      }
    },
    "Lockout": { "MaxFailedAttempts": 5, "DurationMinutes": 15 },
    "DormantDays": 90,
    "AccessReviewIntervalDays": 90
  },
  "VulnerabilityScanning": {
    "Provider": "OSV",
    "OSV": {
      "ApiUrl": "https://api.osv.dev/",
      "BatchSize": 1000,
      "TimeoutSeconds": 30
    },
    "Cache": {
      "Enabled": true,
      "VulnerabilityTtlHours": 24,
      "NoVulnTtlHours": 168,
      "VulnDetailTtlHours": 24,
      "SizeLimit": 100000
    }
  }
}