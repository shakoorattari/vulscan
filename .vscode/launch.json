{
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Core API",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "clean-build-api",
            "program": "${workspaceFolder}/server/src/Vulscan.Api/bin/Debug/net10.0/Vulscan.Api.dll",
            "args": [],
            "cwd": "${workspaceFolder}/server/src/Vulscan.Api",
            "stopAtEntry": false,
            "serverReadyAction": {
                "action": "openExternally",
                "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
                "uriFormat": "%s/swagger"
            },
            "env": {
                "ASPNETCORE_ENVIRONMENT": "Development",
                "ASPNETCORE_URLS": "http://localhost:5000"
            }
        },
        {
            "name": "Angular Client",
            "type": "node",
            "request": "launch",
            "preLaunchTask": "start-angular",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["start"],
            "cwd": "${workspaceFolder}/client",
            "console": "integratedTerminal",
            "internalConsoleOptions": "neverOpen",
            "serverReadyAction": {
                "pattern": "Local:.*(http://localhost:[0-9]+)",
                "uriFormat": "%s",
                "action": "openExternally"
            }
        },
        {
            "name": ".NET Core Attach",
            "type": "coreclr",
            "request": "attach"
        }
    ],
    "compounds": [
        {
            "name": "🚀 Launch API + Angular",
            "configurations": [
                ".NET Core API",
                "Angular Client"
            ],
            "presentation": {
                "hidden": false,
                "group": "full-stack",
                "order": 1
            }
        }
    ]
}