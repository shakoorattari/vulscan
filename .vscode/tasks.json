{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "kill-port-5071",
            "type": "shell",
            "command": "lsof -ti:5071 | xargs kill -9 2>/dev/null || true",
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            },
            "problemMatcher": []
        },
        {
            "label": "clean-api",
            "command": "dotnet",
            "type": "process",
            "args": [
                "clean",
                "${workspaceFolder}/server/src/Vulscan.Api/Vulscan.Api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "build-api",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/server/src/Vulscan.Api/Vulscan.Api.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile",
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "label": "clean-build-api",
            "dependsOrder": "sequence",
            "dependsOn": [
                "kill-port-5071",
                "clean-api",
                "build-api"
            ],
            "problemMatcher": [],
            "group": {
                "kind": "build",
                "isDefault": false
            }
        },
        {
            "label": "start-angular",
            "type": "npm",
            "script": "install",
            "path": "client/",
            "problemMatcher": [],
            "presentation": {
                "reveal": "silent",
                "panel": "shared"
            }
        }
    ]
}
