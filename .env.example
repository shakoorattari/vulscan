# ==============================================================================
# VULSCAN SECURITY CONFIGURATION
# ==============================================================================
# 
# IMPORTANT: 
# 1. Copy this file to .env and fill in secure values
# 2. Never commit .env files to version control
# 3. Use strong, unique passwords and secret keys
# 4. Rotate credentials regularly (30-90 days)
#
# ==============================================================================

# SQL Server Database Configuration
# Generate a strong password: openssl rand -base64 32
SQL_SERVER_PASSWORD=YourSecurePassword!2026

# JWT Token Configuration  
# Generate a secure key: openssl rand -base64 64
JWT_SECRET_KEY=YourJWTSecretKeyMustBeAtLeast64CharactersLongForSecurity!2026

# Application Configuration
ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://localhost:5000

# Optional: Azure DevOps PAT (for production scans)
AZURE_DEVOPS_PAT=your_pat_token_here

# Optional: SMTP Configuration (for email notifications)
SMTP_SERVER=smtp.yourcompany.com
SMTP_PORT=587
SMTP_USERNAME=vulscan@yourcompany.com
SMTP_PASSWORD=your_smtp_password
SMTP_USE_TLS=true

# Optional: Microsoft Teams Webhook (for notifications)
TEAMS_WEBHOOK_URL=https://outlook.office.com/webhook/your_webhook_url